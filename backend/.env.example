# MongoDB Atlas connection string
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.hlytbs7.mongodb.net/?appName=Cluster0


# Database name
MONGODB_DB_NAME=smart_civic_db

# Comma-separated list of allowed CORS origins for the frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: enables the "Analyze with AI" complaint-understanding feature.
# Leave both blank/unset to run the app with AI analysis disabled (the citizen
# form will show a graceful "AI analysis is currently unavailable" message
# and manual entry continues to work normally).
#
# Preferred (free): get a key at https://console.groq.com -- no credit card
# required, generous free tier. Uses only Python's standard library, so no
# extra pip install is needed.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=